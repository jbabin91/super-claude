{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jbabin91/super-claude/plugin.schema.json",
  "title": "Claude Code Plugin Manifest Schema",
  "description": "Schema for Claude Code plugin.json manifest files",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique plugin identifier in kebab-case (no spaces)",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "description": "Plugin version using semantic versioning (e.g., '2.1.0')",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the plugin's purpose"
    },
    "author": {
      "type": "object",
      "description": "Plugin author information",
      "properties": {
        "name": {
          "type": "string",
          "description": "Author's full name"
        },
        "email": {
          "type": "string",
          "description": "Author's email address",
          "format": "email"
        },
        "url": {
          "type": "string",
          "description": "Author's website or GitHub profile URL",
          "format": "uri"
        }
      }
    },
    "homepage": {
      "type": "string",
      "description": "URL to plugin documentation or homepage",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "description": "URL to plugin source code repository",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "description": "License identifier (e.g., 'MIT', 'Apache-2.0', 'GPL-3.0')"
    },
    "keywords": {
      "type": "array",
      "description": "Keywords for plugin discovery and searchability",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "commands": {
      "description": "Custom slash command file paths (relative, starting with ./) - supplements default commands/ directory",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to a single command file or directory",
          "pattern": "^\\./.*"
        },
        {
          "type": "array",
          "description": "Array of command file or directory paths",
          "items": {
            "type": "string",
            "pattern": "^\\./.*"
          },
          "uniqueItems": true
        }
      ]
    },
    "agents": {
      "description": "Custom agent file paths (relative, starting with ./) - supplements default agents/ directory",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to an agent file",
          "pattern": "^\\./.*"
        },
        {
          "type": "array",
          "description": "Array of agent file paths",
          "items": {
            "type": "string",
            "pattern": "^\\./.*"
          },
          "uniqueItems": true
        }
      ]
    },
    "hooks": {
      "description": "Event handler configuration - path to hooks file or inline config",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to hooks configuration file (e.g., './hooks/hooks.json')",
          "pattern": "^\\./.*"
        },
        {
          "type": "object",
          "description": "Inline hooks configuration",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "matcher": {
                  "type": "string",
                  "description": "Pattern to match tool names or events"
                },
                "hooks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["command"],
                        "description": "Type of hook action (currently only 'command' is supported)"
                      },
                      "command": {
                        "type": "string",
                        "description": "Command to execute (can use ${CLAUDE_PLUGIN_ROOT})"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "mcpServers": {
      "description": "Model Context Protocol server configuration - path to config or inline definition",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to MCP configuration file (e.g., './.mcp.json')",
          "pattern": "^\\./.*"
        },
        {
          "type": "object",
          "description": "Inline MCP server configurations",
          "additionalProperties": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "command": {
                "type": "string",
                "description": "Path to server executable (can use ${CLAUDE_PLUGIN_ROOT})"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments for the server",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the server",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the server"
              }
            }
          }
        }
      ]
    }
  }
}
