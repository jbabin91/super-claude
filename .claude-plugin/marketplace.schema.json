{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jbabin91/super-claude/marketplace.schema.json",
  "title": "Claude Code Marketplace Schema",
  "description": "Schema for Claude Code marketplace.json files that define plugin collections",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URL (optional, for IDE validation)"
    },
    "name": {
      "type": "string",
      "description": "Marketplace identifier in kebab-case (no spaces)",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "owner": {
      "type": "object",
      "description": "Marketplace maintainer information",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Owner's full name"
        },
        "email": {
          "type": "string",
          "description": "Contact email address"
        },
        "url": {
          "type": "string",
          "description": "Owner's website or GitHub profile URL"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional marketplace metadata",
      "properties": {
        "version": {
          "type": "string",
          "description": "Marketplace version (semantic versioning)",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$"
        },
        "description": {
          "type": "string",
          "description": "Brief marketplace description"
        },
        "repository": {
          "type": "string",
          "description": "Source code repository URL"
        },
        "homepage": {
          "type": "string",
          "description": "Marketplace homepage URL"
        },
        "license": {
          "type": "string",
          "description": "License identifier (e.g., MIT, Apache-2.0)"
        },
        "pluginRoot": {
          "type": "string",
          "description": "Base path for relative plugin sources"
        }
      }
    },
    "plugins": {
      "type": "array",
      "description": "Array of plugin entries available in this marketplace",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Plugin identifier in kebab-case (no spaces)",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "source": {
            "description": "Where to fetch the plugin (required)",
            "oneOf": [
              {
                "type": "string",
                "description": "Relative path (e.g., './plugins/my-plugin')"
              },
              {
                "type": "object",
                "description": "GitHub repository source",
                "required": ["source", "repo"],
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "github"
                  },
                  "repo": {
                    "type": "string",
                    "description": "GitHub repo in format 'owner/repo'",
                    "pattern": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$"
                  }
                }
              },
              {
                "type": "object",
                "description": "Git URL source",
                "required": ["source", "url"],
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "url"
                  },
                  "url": {
                    "type": "string",
                    "description": "Git repository URL"
                  }
                }
              }
            ]
          },
          "strict": {
            "type": "boolean",
            "description": "Require plugin.json in plugin folder (default: true). When false, marketplace entry serves as complete plugin manifest.",
            "default": true
          },
          "category": {
            "type": "string",
            "description": "Plugin category for organization (e.g., 'development', 'productivity', 'security')"
          },
          "tags": {
            "type": "array",
            "description": "Optional tags for searchability (community extension - use 'keywords' for standard plugin field)",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string",
            "description": "Plugin version (semantic versioning)",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$"
          },
          "description": {
            "type": "string",
            "description": "Brief plugin description"
          },
          "author": {
            "type": "object",
            "description": "Plugin author information",
            "properties": {
              "name": {
                "type": "string",
                "description": "Author's full name"
              },
              "email": {
                "type": "string",
                "description": "Author's email"
              },
              "url": {
                "type": "string",
                "description": "Author's website or GitHub profile"
              }
            }
          },
          "homepage": {
            "type": "string",
            "description": "Plugin documentation URL"
          },
          "repository": {
            "type": "string",
            "description": "Plugin source code URL"
          },
          "license": {
            "type": "string",
            "description": "License identifier (SPDX format recommended)"
          },
          "keywords": {
            "type": "array",
            "description": "Tags for plugin discovery and categorization",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "description": "Custom command file/directory paths (supplement default commands/ directory)",
            "oneOf": [
              {
                "type": "string",
                "description": "Single command file or directory path"
              },
              {
                "type": "array",
                "description": "Array of command file or directory paths",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "agents": {
            "description": "Custom agent file paths (supplement default agents/ directory)",
            "oneOf": [
              {
                "type": "string",
                "description": "Single agent file path"
              },
              {
                "type": "array",
                "description": "Array of agent file paths",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "hooks": {
            "description": "Hooks configuration - path to hooks file or inline config. NOTE: hooks/hooks.json is auto-discovered.",
            "oneOf": [
              {
                "type": "string",
                "description": "Path to hooks configuration file"
              },
              {
                "type": "object",
                "description": "Inline hooks configuration. Valid events: PreToolUse, PostToolUse, PermissionRequest, UserPromptSubmit, Notification, Stop, SubagentStop, SessionStart, SessionEnd, PreCompact",
                "properties": {
                  "PreToolUse": { "$ref": "#/$defs/hookEventArray" },
                  "PostToolUse": { "$ref": "#/$defs/hookEventArray" },
                  "PermissionRequest": { "$ref": "#/$defs/hookEventArray" },
                  "UserPromptSubmit": { "$ref": "#/$defs/hookEventArray" },
                  "Notification": { "$ref": "#/$defs/hookEventArray" },
                  "Stop": { "$ref": "#/$defs/hookEventArray" },
                  "SubagentStop": { "$ref": "#/$defs/hookEventArray" },
                  "SessionStart": { "$ref": "#/$defs/hookEventArray" },
                  "SessionEnd": { "$ref": "#/$defs/hookEventArray" },
                  "PreCompact": { "$ref": "#/$defs/hookEventArray" }
                },
                "additionalProperties": false
              }
            ]
          },
          "mcpServers": {
            "description": "MCP server configuration - path to config or inline definition",
            "oneOf": [
              {
                "type": "string",
                "description": "Path to MCP configuration file"
              },
              {
                "type": "object",
                "description": "Inline MCP server configurations",
                "additionalProperties": {
                  "type": "object",
                  "required": ["command"],
                  "properties": {
                    "command": {
                      "type": "string",
                      "description": "Path to server executable (can use ${CLAUDE_PLUGIN_ROOT})"
                    },
                    "args": {
                      "type": "array",
                      "description": "Command line arguments for the server",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "type": "object",
                      "description": "Environment variables for the server",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "cwd": {
                      "type": "string",
                      "description": "Working directory for the server"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hookEventArray": {
      "type": "array",
      "description": "Array of hook configurations for an event",
      "items": {
        "type": "object",
        "properties": {
          "matcher": {
            "type": "string",
            "description": "Regex pattern to match tool names (e.g., 'Edit|Write', 'Bash'). Required for PreToolUse/PostToolUse/PermissionRequest. For Notification: 'permission_prompt', 'idle_prompt', etc. For SessionStart: 'startup', 'resume', 'clear', 'compact'. For PreCompact: 'manual', 'auto'."
          },
          "hooks": {
            "type": "array",
            "description": "Array of hook actions to execute",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["command", "prompt"],
                  "description": "Type of hook: 'command' (execute bash script) or 'prompt' (LLM-based evaluation)"
                },
                "command": {
                  "type": "string",
                  "description": "For type='command': script to execute. Use ${CLAUDE_PLUGIN_ROOT} for plugin paths."
                },
                "prompt": {
                  "type": "string",
                  "description": "For type='prompt': prompt text to send to LLM. Use $ARGUMENTS as placeholder for hook input JSON."
                },
                "timeout": {
                  "type": "number",
                  "description": "Timeout in seconds for this hook (default: 60 for command, 30 for prompt)"
                }
              }
            }
          }
        },
        "required": ["hooks"]
      }
    }
  }
}
