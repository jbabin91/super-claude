{
  "plugin": {
    "name": "workflow",
    "version": "1.0.0",
    "namespace": "workflow"
  },

  "skills": {
    "configure-activation": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Configure skill auto-activation rules for your project",
      "promptTriggers": {
        "keywords": [
          "configure activation",
          "skill activation",
          "activation rules",
          "customize triggers",
          "skill rules"
        ],
        "intentPatterns": [
          "configur(e|ing).*?(skill|activation)",
          "activation.*?(rules|config|settings)",
          "(customize|modify|change).*?(trigger|activation)",
          "how.*?(skill|activation).*?(work|trigger)"
        ]
      }
    }
  }
}
