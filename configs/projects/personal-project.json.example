{
  "project": "personal-project",
  "description": "Example configuration for personal/open-source projects",
  "inheritGlobal": true,

  "skills": [
    "// TypeScript development",
    "typescript/tsc-files-validation",
    "typescript/refactor-imports",
    "typescript/generate-tests",

    "// Testing",
    "testing/vitest-integration",
    "testing/coverage-improve",

    "// Git workflow",
    "git/smart-commit",
    "git/pr-description",
    "git/changelog"
  ],

  "exclude": [
    "// No work-specific skills",
    "work/*",
    "local/*"
  ],

  "agents": [
    "test-implementer",
    "code-reviewer"
  ],

  "notes": [
    "Copy to [your-project-name].json",
    "Remove comment lines (starting with //)",
    "Customize skills for your project needs"
  ]
}
