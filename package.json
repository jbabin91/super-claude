{
  "name": "super-claude",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "commit": "cz",
    "commit:lint": "commitlint --edit",
    "format": "prettier -uwl --cache .",
    "format:check": "prettier -uc --cache .",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate-schemas.ts",
    "validate:changed": "bun run scripts/validate-schemas.ts --changed",
    "validate:verbose": "bun run scripts/validate-schemas.ts --verbose"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.0",
    "@jbabin91/tsc-files": "^0.8.3",
    "@types/bun": "1.3.2",
    "arktype": "^2.1.26",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "lefthook": "^2.0.3",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=24.11.0"
  }
}
